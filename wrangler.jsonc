{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stocktake",
  // OpenNext's generated handler plus the nightly demo reset.
  "main": "worker.mjs",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference binding the adapter uses for internal requests; must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "stocktake",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stocktake",
      "database_id": "3304c2f0-d5c4-4f31-8d97-a138818f238b",
      "migrations_dir": "drizzle",
    },
  ],
  // Workers AI, for the assistant. Always runs remotely, also under `next dev`.
  "ai": {
    "binding": "AI",
  },
  // The demo starts over at midnight in Dhaka (UTC+6, no daylight saving), which is
  // 18:00 UTC; cron schedules run on UTC. src/seed/reset.test.ts keeps the two in step.
  "triggers": {
    "crons": ["0 18 * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
