{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stocktake",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference binding the adapter uses for internal requests; must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "stocktake"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stocktake",
      // Replace with the ID printed by `wrangler d1 create stocktake` before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
